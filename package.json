{
  "name": "partial-content",
  "version": "5.0.0",
  "description": "RFC-compliant HTTP file serving and resumable uploads for any storage backend. Range requests (206), conditional caching (304/412), Content-Disposition, ETag generation, and a resumable-upload engine speaking tus 1.0 and the IETF resumable-uploads draft. Zero dependencies.",
  "keywords": [
    "206",
    "304",
    "412",
    "416",
    "azure-blob",
    "bun",
    "byte-range",
    "cloudflare-workers",
    "conditional-request",
    "content-disposition",
    "deno",
    "etag",
    "etag-generation",
    "express",
    "fastify",
    "file-serving",
    "gcs",
    "hetzner",
    "hono",
    "http",
    "multipart-upload",
    "nextjs",
    "object-storage",
    "optimistic-concurrency",
    "partial-content",
    "pdf",
    "presigned-url",
    "r2",
    "range-request",
    "resumable-upload",
    "resume-download",
    "s3",
    "streaming",
    "supabase-storage",
    "tus",
    "upload",
    "video-seeking"
  ],
  "homepage": "https://github.com/nordvec/partial-content#readme",
  "bugs": "https://github.com/nordvec/partial-content/issues",
  "license": "Apache-2.0",
  "author": "Nordvec <oss@nordvec.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nordvec/partial-content.git"
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "README.md",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "bun": "./src/s3.ts",
      "import": "./dist/s3.js",
      "default": "./dist/s3.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "bun": "./src/web.ts",
      "import": "./dist/web.js",
      "default": "./dist/web.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "bun": "./src/fs.ts",
      "import": "./dist/fs.js",
      "default": "./dist/fs.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "bun": "./src/node.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "bun": "./src/hono.ts",
      "import": "./dist/hono.js",
      "default": "./dist/hono.js"
    },
    "./gcs": {
      "types": "./dist/gcs.d.ts",
      "bun": "./src/gcs.ts",
      "import": "./dist/gcs.js",
      "default": "./dist/gcs.js"
    },
    "./azure": {
      "types": "./dist/azure.d.ts",
      "bun": "./src/azure.ts",
      "import": "./dist/azure.js",
      "default": "./dist/azure.js"
    },
    "./r2": {
      "types": "./dist/r2.d.ts",
      "bun": "./src/r2.ts",
      "import": "./dist/r2.js",
      "default": "./dist/r2.js"
    },
    "./mime": {
      "types": "./dist/mime.d.ts",
      "bun": "./src/mime.ts",
      "import": "./dist/mime.js",
      "default": "./dist/mime.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "bun": "./src/http.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "bun": "./src/memory.ts",
      "import": "./dist/memory.js",
      "default": "./dist/memory.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "bun": "./src/conformance.ts",
      "import": "./dist/conformance.js",
      "default": "./dist/conformance.js"
    },
    "./package.json": "./package.json",
    "./redis-locker": {
      "types": "./dist/redis-locker.d.ts",
      "bun": "./src/redis-locker.ts",
      "import": "./dist/redis-locker.js",
      "default": "./dist/redis-locker.js"
    },
    "./tus": {
      "types": "./dist/tus.d.ts",
      "bun": "./src/tus.ts",
      "import": "./dist/tus.js",
      "default": "./dist/tus.js"
    },
    "./upload": {
      "types": "./dist/upload.d.ts",
      "bun": "./src/upload.ts",
      "import": "./dist/upload.js",
      "default": "./dist/upload.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node scripts/write-sbom.mjs",
    "test": "bun test --parallel=4 --timeout 30000",
    "test:mutation": "bun scripts/mutation-run.mjs",
    "test:mutation:ci": "bun scripts/mutation-ci.mjs",
    "prepublishOnly": "npm run build && npm run check:doc-types && npm run check:api-docs && npm run check:exports && npm run check:consumer-types && node scripts/check-changelog-version.mjs && node scripts/check-tarball.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "bun ../../scripts/ci/lint.ts",
    "check:doc-types": "node scripts/check-doc-types.mjs",
    "check:doc-options": "node scripts/check-doc-options.mjs",
    "check:api-docs": "node scripts/api-doc-regions.mjs --check",
    "typecheck:tests": "bun check -p tsconfig.tests.json",
    "typecheck": "bun check",
    "bench": "npm run build && node bench/run.mjs",
    "smoke": "npm run build && node smoke/smoke.mjs",
    "smoke:node": "npm run build && node smoke/node-bridge.mjs",
    "check:exports": "npm run build && attw --pack . --profile esm-only",
    "check:consumer-types": "npm run build && tsc --noEmit -p smoke/tsconfig.consumer.json",
    "test:live": "bun test src/__tests__/s3-live.test.ts",
    "size": "npm run build && size-limit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^26.6.5",
    "autocannon": "^8.0.0",
    "fast-check": "^4.10.2",
    "send": "^1.2.1",
    "sirv": "^3.0.2",
    "size-limit": "^14.2.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.400.0",
    "@aws-sdk/s3-request-presigner": "^3.400.0",
    "@azure/storage-blob": ">=12.0.0",
    "@google-cloud/storage": ">=7.0.0",
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
